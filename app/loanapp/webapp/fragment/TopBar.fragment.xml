<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <HBox id="_IDGenHBox85" class="cockpitTopBar" alignItems="Center" justifyContent="SpaceBetween">
        <VBox id="_IDGenVBox148">
            <Text id="_IDGenText314" text="Loan Operations Cockpit" class="topBarTitle"/>
            <Text id="_IDGenText315" text="Monitor · Manage · Accelerate" class="topBarSubtitle"/>
        </VBox>
        <SearchField id="globalSearchField" placeholder="Search applications, applicants, or reference number..." width="380px" class="topBarSearch" search="onGlobalSearch"/>
        <HBox id="_IDGenHBox89" alignItems="Center" class="topBarRight">
            <core:Icon id="_IDGenIcon52" src="sap-icon://bell" class="topBarBellIcon"/>
            <HBox id="_IDGenHBox184" class="topBarAvatar" alignItems="Center"><Text id="_IDGenText316" text="{user>/initials}" class="topBarAvatarInitials"/></HBox>
            <VBox id="_IDGenVBox149">
                <Text id="_IDGenText317" text="{user>/name}" class="topBarUserName"/>
                <Text id="_IDGenText318" text="{user>/role}" class="topBarUserRole"/>
            </VBox>
        </HBox>
    </HBox>

</core:FragmentDefinition>