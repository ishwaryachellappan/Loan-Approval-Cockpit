<mvc:View
    controllerName="loan.cockpit.loanapp.controller.FilteredList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="_IDGenPage1" class="sapUiContentPadding filteredListPage">
    <customHeader>
        <Bar id="_IDGenBar">
            <contentLeft>
                <Button id="_IDGenButton" icon="sap-icon://nav-back" type="Transparent" press="onNavBack"/>
            </contentLeft>
            <contentMiddle>
                <VBox id="_IDGenVBox">
                    <Title id="_IDGenTitle" text="{filtered>/title}" level="H3"/>
                    <Text id="_IDGenText15" text="{= ${filtered>/rows}.length + ' application(s)'}" class="filteredListSubtext"/>
                </VBox>
            </contentMiddle>
        </Bar>
    </customHeader>
    <content>
        <VBox id="_IDGenVBox5" class="filteredListCard">
            <Table id="_IDGenTable" items="{filtered>/rows}" noDataText="No applications match this filter" showSeparators="Inner">
                <columns>
                    <Column id="_IDGenColumn"><Text id="_IDGenText16" text="Application No."/></Column>
                    <Column id="_IDGenColumn1"><Text id="_IDGenText17" text="Applicant"/></Column>
                    <Column id="_IDGenColumn2"><Text id="_IDGenText18" text="Product"/></Column>
                    <Column id="_IDGenColumn3" hAlign="End"><Text id="_IDGenText19" text="Requested Amount"/></Column>
                    <Column id="_IDGenColumn4" hAlign="Center"><Text id="_IDGenText20" text="Status"/></Column>
                    <Column id="_IDGenColumn5"/>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem" type="Navigation" press="onRowPress" class="filteredListRow">
                        <cells>
                            <Text id="_IDGenText21" text="{filtered>applicationNumber}" class="filteredListAppNo"/>
                            <Text id="_IDGenText22" text="{filtered>applicant/firstName}"/>
                            <Text id="_IDGenText23" text="{filtered>product/productName}"/>
                            <ObjectNumber id="_IDGenObjectNumber" number="{filtered>requestedAmount}" unit="INR"/>
                            <HBox id="_IDGenHBox14" justifyContent="Center">
                                <HBox id="_IDGenHBox15" class="{= ${filtered>status} === 'EXCEPTION' ? 'filteredStatusPill filteredStatusRed' : (${filtered>status} === 'READY_FOR_REVIEW' ? 'filteredStatusPill filteredStatusGreen' : 'filteredStatusPill filteredStatusBlue') }">
                                    <Text id="_IDGenText24" text="{filtered>status}"/>
                                </HBox>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </content>
</Page>
</mvc:View>