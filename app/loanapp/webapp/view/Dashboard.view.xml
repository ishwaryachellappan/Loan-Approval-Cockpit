<mvc:View
    controllerName="loan.cockpit.loanapp.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    xmlns:mc="sap.suite.ui.microchart"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="_IDGenPage" title="Operations Dashboard" showNavButton="true" navButtonPress="onNavBack" class="sapUiContentPadding">
        <content>

           <ScrollContainer id="_IDGenKpiScroll" horizontal="false" vertical="false" width="100%" height="auto" class="sapUiSmallMarginBottom">
    <VBox id="_IDGenKpiSection" class="kpiSectionContainer">
        <FlexBox id="_IDGenKpiRow" wrap="Wrap" fitContainer="true" renderType="Bare"
            justifyContent="SpaceBetween" alignItems="Stretch" width="100%" class="kpiSummaryRow">

            <VBox id="kpiSlaBreached" class="kpiCard" width="100%" height="100%">
    <HBox id="_IDGenHBox" class="kpiCardTopRow">
        <Text id="_IDGenText" text="SLA Breached" class="kpiCardLabel"/>
        <HBox id="_IDGenHBox1" class="kpiIconBox kpiIconDarkRed"><core:Icon id="_IDGenIcon" src="sap-icon://alert"/></HBox>
    </HBox>
    <Text id="_IDGenText1" text="{dashboard>/slaBreachedCount}" class="kpiCardValue kpiValueDarkRed"/>
</VBox>

<VBox id="_IDGenVBox1" class="kpiCard kpiCardNoClick" width="100%" height="100%">
    <HBox id="_IDGenHBox2" class="kpiCardTopRow">
        <Text id="_IDGenText2" text="SLA Breach Rate" class="kpiCardLabel"/>
        <HBox id="_IDGenHBox3" class="kpiIconBox kpiIconOrange"><core:Icon id="_IDGenIcon1" src="sap-icon://pending"/></HBox>
    </HBox>
    <Text id="_IDGenText3" text="{dashboard>/slaBreachRate}%" class="kpiCardValue kpiValueOrange"/>
</VBox>

<VBox id="kpiOpenExceptions" class="kpiCard" width="100%" height="100%">
    <HBox id="_IDGenHBox4" class="kpiCardTopRow">
        <Text id="_IDGenText4" text="Open Exceptions" class="kpiCardLabel"/>
        <HBox id="_IDGenHBox5" class="kpiIconBox kpiIconRed"><core:Icon id="_IDGenIcon2" src="sap-icon://message-warning"/></HBox>
    </HBox>
    <Text id="_IDGenText5" text="{dashboard>/openExceptionsCount}" class="kpiCardValue kpiValueRed"/>
</VBox>

<VBox id="_IDGenVBox2" class="kpiCard kpiCardNoClick" width="100%" height="100%">
    <HBox id="_IDGenHBox6" class="kpiCardTopRow">
        <Text id="_IDGenText6" text="Ageing Queue" class="kpiCardLabel"/>
        <HBox id="_IDGenHBox7" class="kpiIconBox kpiIconBlue"><core:Icon id="_IDGenIcon3" src="sap-icon://history"/></HBox>
    </HBox>
    <Text id="_IDGenText7" text="{dashboard>/agedApplicationsCount}" class="kpiCardValue kpiValueBlue"/>
</VBox>

<VBox id="kpiTotalApps" class="kpiCard" width="100%" height="100%">
    <HBox id="_IDGenHBox8" class="kpiCardTopRow">
        <Text id="_IDGenText8" text="Total Applications" class="kpiCardLabel"/>
        <HBox id="_IDGenHBox9" class="kpiIconBox kpiIconBlue"><core:Icon id="_IDGenIcon4" src="sap-icon://document"/></HBox>
    </HBox>
    <Text id="_IDGenText9" text="{dashboard>/totalApplications}" class="kpiCardValue kpiValueBlue"/>
</VBox>

<VBox id="_IDGenVBox3" class="kpiCard kpiCardNoClick" width="100%" height="100%">
    <HBox id="_IDGenHBox10" class="kpiCardTopRow">
        <Text id="_IDGenText10" text="Avg. Priority Score" class="kpiCardLabel"/>
        <HBox id="_IDGenHBox11" class="kpiIconBox kpiIconPurple"><core:Icon id="_IDGenIcon5" src="sap-icon://line-chart"/></HBox>
    </HBox>
    <Text id="_IDGenText11" text="{dashboard>/avgPriorityScore}" class="kpiCardValue kpiValuePurple"/>
</VBox>

<VBox id="_IDGenVBox4" class="kpiCard kpiCardNoClick" width="100%" height="100%">
    <HBox id="_IDGenHBox12" class="kpiCardTopRow">
        <Text id="_IDGenText12" text="Avg. Approval Cycle" class="kpiCardLabel"/>
        <HBox id="_IDGenHBox13" class="kpiIconBox kpiIconGreen"><core:Icon id="_IDGenIcon6" src="sap-icon://time-entry-request"/></HBox>
    </HBox>
    <Text id="_IDGenText13" text="{ path: 'dashboard>/avgApprovalCycleDays', formatter: '.formatCycleDays' }" class="kpiCardValue kpiValueGreen"/>
</VBox>

        </FlexBox>
    </VBox>
</ScrollContainer>

           

        </content>
    </Page>
</mvc:View>